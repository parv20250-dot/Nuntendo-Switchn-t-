void drawBatteryicon (int x. int y, int percent, bool present){
  tft.fillRect(x-1,y-1.28,14,purple); //draws a rectangle
  tft.drawRect(x,y,27,12,Lessdark_purple); //draws outline
  tft.fillRect(x+27, y+3,2,6,Lessdark_purple); //makes rectangle battery icon,, adds smol rectangle
  if(!present){drawTextAt(x+6, y+2,"USB",1,Lessdark_purple);
    return;}
  int bars = (percent + 10)/20; //no of bars outta 5
  if(bars >5) bars =5;
  uint 16_t color;
  if (percent> 25){
    color = green;} //full battery = green 
  else{color = RED;} //low battery = red
  for (int i = 0; i<bars; i++){
    tft.fillRect(x+2+i*4,y+2,3,8,color);}} //fills bars according to battery level

