const int iconswidth = 40;
const int iconsheight = 40;

void drawgameicon(const uint16_t*imagedata, int width, int height, int centX,
  int centY){
  int imagex = centX - width/2;
  int imagey = centY - height /2; //where img starts from,left and top
  tft.drawRGBBitmap(imageX,imageY,imageData,width,height);}
void drawiconoutline(int i, bool selected){
  int col =i%2; //calculates col
  int row =i/2 //calculates row 
  int x = 8+col*116 //how far from left edge
  int y = 28+row*100//how far from top
  uint color1 = GAMESSSSS[i].color();
  tft.fillRect(x-4,y-4,menuiconwidth+8,menuiconlength+8,purple);
  //clears the space by drawing rectangle in bg color
  tft.fillRoundRect(x,y,menuiconwidth,menuiconlength,6,Lessdark_purple);
  //draws tile background, area around tile 
  uint 16_t bordercolor;
  if(selected==true){bordercolor =accent;}
  else{bordercolor = dimcolor(accent);} //selects color acc gamee
  //it glowy if selected
  tft.drawRoundrect(x,y,menuiconwidth,menuiconlength,6,bordercolor);
  //draws main border (either bright or dim)
  if (selected ==true){tft.drawRoundRect(x-3,y-3,menuiconwidth+6,
  menuiconlength+6,9,accent);
  tft.drawRoundRect(x-2,y-2,menuiconwidth+4,menuiconlength+4,8,accent);}
  //draws extra glowy borders on top of main border
  int iconcenterx = x+menuiconwidth/2;
  int iconcenty = y+32; // icon position,center x and y
  if(i==SNAKE){
    drawgameicon(snakeicon,iconswidth,iconsheight,iconcenterx,iconcenty);}
  else if (i==TETRIS){
    drawgameicon(tetrisicon,iconswidth,iconsheight,iconcenterx,iconcenty);}
  else if (i==PONG){
    drawgameicon(pongicon,iconswidth,iconsheight,iconcenterx,iconcenty);}
  //TO DO RUN 
  draw_text_center(cx,y+menuiconlength-30,GAMESSSSS[I].name,2,accent);
  //prints name of gamee
  char best[20]; //20 character array holds high score
  snprintf(best,sizeof(best),"BEST%lu",(unsigned long)save.highscore[i]);
  //converts nos to text,prints high score in game
  draw_text_center(cx,y+menuiconlength-11,best,1,color_text)
}
