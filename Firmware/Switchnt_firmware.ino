if(pongvx > 0 && pongballx+pongball>=pongrightx &&
  pongballx<= pongrightx+pongpaddle_width && pongbally+pongball >=pongcompy &&
  pongbally <= pongcompy+pongpaddle_height){
    pongballx =pongrightx-pongball; //if its has hit paddle,puts it outside
    pongvx =-pongvx; //reverses direction
    pongvy = ((pongbally+pongball/2)-(pongcompy+pongpaddle_height/2))/7;
    pongvy += random(-1,2); 
    pongcompaim =random(-14,15);} //new random offset
if (pongvy > 5){pongvy =5;}
if (pongvy < -5){pongvy=-5;} //limits in between -5,5, no too fast
if (pongballx +pongball<0){
  if(pongpoint(false)){
    return false;}
  return true;} //if ball has left left side,comp scores, else player
if(pongpoint(true)){
