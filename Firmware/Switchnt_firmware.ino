bool musicmuted = false; //the X botton, mutes soundtrack
int currenttrack =1; //currently selected sountrack, each game has diif track

void musicstart(){
  if (!playeryes or musicmuted or !save.musicon)
  //returns if player did not answer, music muted, no saved music
  return;
  player.volume(20); //sets volume at 20
  player.playMp3Folder(currenttrack); //plays current track
  player.enableLoop();} //loops track

void musicStop(){
  if(!playeryes)return;
  player.stop();}     //checks if its working if it is stops current track

void  musicchange(int track){
  if(currenttrack== track)
  return;
  currenttrack =track;
  musicstart();} //if new track is same then return else plays new track

void musicapply(){
  if (save.musicon && !musicmuted){
    musicstart();}
  else{musicStop();}} //if music is on and not muted it plays else it stops

//Buzzer
const Note SFX_YAYY[]={
  {1760,70},{2093,70},{2637,140}} //rising note (sumn good happens)
const Note SFX_WOMP[]={
  {600,140},{420,140},{300,280}};//falling note (sumn bad happens)
const Note SFX_TICK[]={{2000,60}};
const Note SFX_GO []={{2600,220}};
//notes 

const Note*sfxlist = nullptr; //beep rn
int sfxlength = 0 //length default value
int sfxindex = 0; //which note 
uint32_t sfxend = 0; //when the note should end
bool sfxplaying = false; //default value tru when playing

void buzzeridle(){
  notone(BUZZER_PIN);pinMode(BUZZER_PIN,OUTPUT);
  #if BUZZER_ACTIVE
  digitalWrite(BUZZER_PIN,HIGH);
  #endif
} //puts Buzzer on high (passive state)

void sfxstartnote(){
  tone(BUZZER_PIN, sfxlist[sfxindex].frequency);
  sfxend = millis() + sfxlist[sfxindex].ms;} //starts the current note, its duration

void sfxplay(const Note *list, int length){
  if (!save.sfxon) return; //if nothing saved return
  sfxlist = list 
  sfxlength = length
  sfxindex = 0;
  sfxplaying = true; //sets the details for the specific note then calls start note
  //so that that note is played
  sfxstartnote();}

void soundUpdate(){ //updates sound being played
  if (!sfxplaying) return; //if no sound being played then exits
  if (millis()>= sfxend){sfxindex++; 
      if (sfxindex >= sfxlength){
        sfxplaying = false;
        buzzer idle();} //stops playing makes buzzer idle
      else{sfxstartnote();}}} //starts next note

void sfxyay(){sfxplay(SFX_YAYY,sizeof(SFX_YAYY)/sizeof(SFX_YAYY[0]));} 
  //calls rising tune (good)
void sfxwomp(){sfxplay(SFX_WOMP,sizeof(SFX_WOMP)/sizeof(SFX_WOMP[0]));}
//calls falling tune (bad)
void sfxtick(){sfxplay(SFX_TICK,sizeof(SFX_TICK)/sizeof(SFX_TICK[0]));}
//calls the tick sound
void sfxgo(){sfxplay(SFX_GO,sizeof(SFX_GO)/sizeof(SFX_GO[0]));}
//calls teh go sound

void Mutesound(){
  musicmuted = !musicmuted;
  if (musicmuted){musicStop();}
  else{musicstart();}} //mute settings, if music muted it stops music, else plays

