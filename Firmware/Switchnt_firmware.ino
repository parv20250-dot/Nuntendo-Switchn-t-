void inputBegin (){
  for(int i = 0; i< Button_COUNT; i++){
    pinMode(BUTTON_PINS[i], INPUT_PULLUP);
    buttonheld[i]= false;
    buttonpressed[i] = false;
    buttonlastchange[i]= 0;}} //sets everything to default values at start

