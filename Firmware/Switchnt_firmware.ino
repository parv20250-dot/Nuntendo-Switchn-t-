    buttonpressed[i]= false; //resets before checking/getting input
    bool down = digitalRead(BUTTON_PINS[i])== LOW;
   if (down != buttonheld[i] && now- buttonlastchange[i] >= debounceMS){
    buttonheld[i]= down;//updates all if down
    buttonLastChange[i]= now; 
  if (down) buttonpressed[i]= true; //updates all if down

  bool held (Button b){return buttonheld[b];}
  bool pressed(Button B){return buttonpressed[b];} //which button was just held or pressed
