    newscreen =false;
    tft.fillScreen(purple);//erases screen
    draw_text_center(Screen_Width/2,16,"GET READY!!",2,Lessdark_purple);
    draw_text_center(Screen_Width/2,70,"3",12,GAMESSSSS[currentgame].color);
    delay(1000);
    draw_text_center(Screen_Width/2,70,"2",12,GAMESSSSS[currentgame].color);
    delay(1000);
    draw_text_center(Screen_Width/2,70,"1",12,GAMESSSSS[currentgame].color);
    delay(1000);
    draw_text_center(Screen_Width/2, 84,"GO!",8,GAMESSSSS[currentgame].color);
    delay(50);
    paused = false; //plays 3,2,1,go,avoids immediately bobarding player with game
