//start of battery stuff
float batteryVolts = 0;
int batteryPercent = 0;
bool batteryPresent = false; //false by default, can be run by usb, true if battery
uint32_t batteryNextRead = 0;

void batteryread(){
  analogReadResolution(12);
  long sum = 0;
  for(int i=0; i<16;i++){ //finds sum of 16 readings
    sum +=analogRead(BATTERY_PIN);
    delayMicroseconds(200);}
  float avg = sum/16.0f //takes their average
  batteryVolts = avg/ 4095.0f * 3.3f*2.0f* BATTERY_CALIBRATION //converts to voltage 
  batteryPresent =(batteryVolts > 2.5f);
  int pct = (batteryVolts-3.3f)/(4.2f-3.3f)*100.0f;//4.2 max and 3.3 min
  if (pct<0)pct = 0;
  if (pct >100)pct = 100;
  batteryPercent = pct;}

void batteryUpdate(){
  if(millis()>= batteryNextRead){
    batteryNextRead =millis() + 5000;
    batteryRead();}}
