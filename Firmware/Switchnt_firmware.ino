          tetboard[0][c]=0;} //clears top row because its alr been copied to row down
         cleared++; //rows cleared increases
         r++; //checks row again, if its moved new row must be checked,loop moves
  return cleared;}
bool tetfreezeandnew(){
  uint16_t shape=tetshapes[tettype][tetRot]; //gets shape
  for(int i= 0; i< 16;i++){
    if (shape &(0x8000>>i)){ //checks all positions again
      int col =tetx+i%4;
      int row = tety+i/4; //calculates where it belongs
      if (row>=0)tetboard[row][col]= tetType+1;}} //piece on tet boRD
    int cleared =tetclearlines(); //checks if new piece completes rows/columns
    if(cleared >0){//if cleared awards points
      tetrisscore += tetlinepoints[cleared]*(tetlevel+1); //calculates acc no of
      // rows cleared and level adds to score
      tetlines += cleared; //lines cleared
      tetlevel = tetlines/10; //10 lines = lvel +1
      tetdrawboard(); //draws board again
      sfxyay();}
    return tetspawn();}

void tetrisstart(){
  gameWon=false;
  for (int r = 0; r<tetrows;r++){
    for(int c=0;c<tetcolums;c++){
      tetboard[r][c]=0;}} //nested loop, loops through all rows, all columns 
      //in a row, sets them to 0(clear)
  tetrisscore =0;
  tetlines =0;
  tetlevel=0;
  tetlastdir=0;
  tettype = -1; //aka no value yet
  tetnext = tetRandomPiece();
  tetrisredraw();
  tetspawn(); //draws screen, then first piece
  tetnextdrop = millis() +700; //current time and then 700ms
  tetrepeatat = 0;
  tettetnextlim = 0;
booltetrisupdate(){
    uint32_t now = millis();
    int dir = 0; //no horizontal directions yer
    if(held(Button_left)){dir =-1} //left button is held, direction -1,left
    if(held(Button_right)){dir =1} //right button hel,direction 1,right
    if (dir ==0){tetlastdir=0;} //resets directionf memmory
    else if (dir != tetlastdir){
      tetlastdir=dir;tettrymove(dir,0,0);tetrepeatat = now +180;} //moves once
      //waits 180 ms
    else if ((int32_t)(now-tetrepeatat)>=0){
      tettrymove(dir,0,0);
      tetrepeatat=now+60;} //after first 180,it moves every 60 ms
    if(pressed(Button_up)){tettryrotate();}//tries to rottate piece if up button
    if (pressed(Button_A)){int cells =0;}//A allows for hard drp,locks
    if((int32_t)(now-tetnextdrop)>=0){ //if its time for next drop
      tetnextdrop = now + tetdropinterval();//schedules next drop
      if(!tettrymove(0,1,0)){ //if not true,no moved down 
        return tetfreezeandnew();}}//locked and new one spawns
  return true;}}
//end of tetris
