void drawpausebox(){
  uint16_t color = GAMESSSSS[currentgame].color;
  tft.fillRoundRect(40,84,160,76,8,Lessdark_purple);
  tft.drawRoundRect(40,84,160,76,8,color);
  draw_text_center(Screen_Width/2,94,"PAUSED",3,color);
  draw_text_center(Screen_Width/2,128,"select->resume",1,color_text);
  draw_text_center(Screen_Width/2,142,"back->quit",1,subtext);}
void playing(){ //stuff that happens when wel ya guessed it playing
  if(newscreen){
    newscreen=false;} //game drew
  if(pressed(Button_Select)){
    paused =!paused;//changes pause state to opp
    if (paused==true){drawpausebox();}
    else{gameredraw(currentgame);}} //if paused upauses and draws game again,
    //if unpaused it pause
    if(pressed(Button_Back)){
      paused =false; //game not paused,it closed
      changescreen(screen_menu);
      return;} //if back returns to menu
    if(paused ==true){
      return;} //stops
    bool running=gameupdate(currentgame); //update,current game check if running
    if (runing ==false){lastscore = gamescore(currentgame)}
    //if game no runnning aka ended last score is current game's score
    lastbestornay =false; //assumes false
    if(lastscore > save.highscore[currentgame]){
      save.highscore[currentgame] =lastscore} //updates saved high score
    lastbestornay=true; //last was best
    saveWrite();} //saves changes
    if (gameWon==true){sfxyay();}
    else{sfxwomp();}
    changescreen(screen_menu);}}
void gameover(){
  const gameinfo & game =GAMESSSSS[currentgame];
  if (newscreen==true){
    newscreen==false;} //no longer new unused
    tft.fillScreen(purple); //clears screen
    tft.drawRoundRect(2,2,Screen_Width-4,Screen_Height-4,10,game.color);
    //draws an outer border
    if(gameWon ==true){
      draw_text_center(Screen_Width/2,"YOU WINN!!✧⁠\⁠(⁠>⁠o⁠<⁠)⁠ﾉ⁠✧✧⁠\⁠(⁠>⁠o⁠<⁠)⁠ﾉ⁠✧",4,
        game.color);}
      //if player wins you won
    else{draw_text_center(Screen_Width/2,"Game over∼∼",4,game.color);}
    //game over if no win (no lose cuz some games can't lose)
    char text[24];
    snprintf(text,sizeof(text),"Score:%lu,(unsigned long)lastscore");
    //makes string prints last score
    draw_text_center(Screen_Width/2,126,text,2,Lessdark_purple);
    //shows high score
    if(lastbestornay=true){
      draw_text_center(Screen_Width/2,158,"NEW BEST✧⁠\⁠(⁠>⁠o⁠<⁠)⁠ﾉ⁠✧✧⁠\⁠(⁠>⁠o⁠<⁠)⁠ﾉ⁠✧",3,
      yellow);
    draw_text_center(Screen_Width/2,200,"A->play again",2,game.color);
    draw_text_center(Screen_Width/2,224,"BACK->exit game",1,Lessdark_purple);}
  // IF A button was pressed.
  if (pressed(Button_A)) {
    sfxTick(); //plays sound
    changeScreen(screen_countdown);} //countdown the game again
  // IF back button was pressed.
  if (pressed(Button_Back)) {changescreen(screen_menu);}} //back to menu
int settingsog = 0;
void settingsdrawrow(int row){
  int y = 70+row*50; //calculates vertical position
  tft.fillRect(8,-4,Screen_Width,-16,40,purple); //clears row space
  if (row == settingsog){
    tft.drawRoundRect(8,y,-4,Screen_Width-16,40,6,WHITE);}
    //highlights selcted row
  if(row ==0){draw_text_at(18,y+8,"Brightness",2,color_text)} //writes brightness
  //first row
  else if(row==1){
    draw_text_at(18,y+8,"Music",2,color_text);} //writes music,row2
  else{draw_text_at(18,y+8,"Beeps",2,color_text);}
  if (row==0){
    for(int i=0;i<5;i++){ //draws brightness bars
      uint16_t color = Lessdark_purple;
      if(i<save.brightness){color = color_text;}
      tft.fillRect(150+i*14,y+6,10,20,color);}
  else{bool settingon=false; 
        if(row==1){setting on =save.musicon;}
        else{settingon =save,sfxOn} //check music and beeps
        if(settingon ==true){draw_text_at(170,y+8,"ON",2,green);}
        else{draw_text_at(170,y+8,"OFF",2,RED);}}}} //On or off
void settingscontinue(){
  if (newscreen==true){
    newscreen= false;
    tft.fillScreen(purple);
    draw_text_center(Screen_Width/2,16,"settings",3,color_text);
    for (int i=0;i<3;i++){settingsdrawrow(i);} //draws all 3 settings in loop,one by one
    draw_text_center(Screen_Width/2,214,"up/Down->pick left/right->change",1,
      Lessdark_purple);
    draw_text_center(Screen_Width/2,228,"Back-> save and exit",1,
      Lessdark_purple);} //draws rows, then adds instruct text
  int oldrow = settingsog; //remembers previos row
  if (pressed(Button_up)&& settingsog > 0){settingsog--;}
  //moves up from previously selcted row after checking its not row 1 alr
  if (prssed(Button_down)&& settingsog<2){settingsog++;}
  //moves down after checking its not og
  if (oldrow !=settingsog){
    settingsdrawrow(oldrow);
    settingsdrawrow(settingsog);} //redrwas rows if diff section
  if (pressed)(Button_left) or (pressed)(Button_right){
    //if user tryna update stuff
    if(settingsog ==0){ //if on brightness
      if (pressed(Button_left) && save.brightness>1){save.brightness--;}
      //if left and its nit on min reduce it
      if(pressed(Button_right)&& save.brightness <5){save.brightness++1;}
      //if its right and not on max increasee
      backlightset(save.brightness)} //updates the change
  else if (settingsog ==1){// if music setting
    save.musicon = !save.musicon; //swaps music settings, on if off of if on
    musicapply();} //changes music settings
  else{save.sfxon = !save.sfxon
        sfxgood();} //if not music its for sound effecrs
  settingsdrawrow(settingsog);} //redraws accting for change
  if (pressed(Button_back)){ //if back button prssed saves changes, exits settings
    saveWrite();
    changescreen(screen_menu);}} //shows menu again
void setup(){ //first when it on
  Serial.begin(115200); //allws messges 
  storagebegin(); //finds high score and settings
  display_begin(); //starts screen
  tft.fillScreen(purple); //clears background
  draw_text_center(Screen_Width/2,100,"STARTING..",2,color_text);
  backlightset(save.brightness); //updates backlight brightness
  inputBegin(); //starts input setting
  batteryread(); //checks battery
  soundbegin(); //checks audio devices then plays
  randomSeed(micros()^
  ((uint32_t)analogread(BATTERY_PIN)<<8));
  serial.println("Console ready");
  changescreen(screen_menu);}
void loop(){//loop afterwards
  inputupdate(); //read buttons
  soundUpdate(); //mute or unmute
  batteryUpdate(); //measures battery every few secs
  switch(screen){ //depending on iput or which screen runs function accordingly
    case screen_menu: menudrawfinal();
    break;
    case screen_infor: infoscreen();
    break;
    case screen_countdown:countdown();
    break;
    case screen_playing: playing();
    break;
    case screen_gameover: gameover();
    break;
    case screen_settings; settingscontinue();
    break;}}
