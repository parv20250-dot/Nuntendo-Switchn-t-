    pongserving=false;} //waiting period over served
  return true;} //else not served
pongDrawBall(purple); //erases old position
pongballx+=pongvx; //new horizontal velocity
pongbally+=pongvy;//new vertical velocuty
if (pongbally <= pongtop){pongbally=pongtop; pongvy =-pongvy;}
//if it goes out of screen on top wall,bring it back in reverse velocity 
if(pongbally >=Screen_Height-pongball){pongbally= Screen_Height-pongball;
pongvy = -pongvy;}
if(pongvx<0 && pongballx <= pongleftx+pongpaddle_width
   &&pongballx+pongball >=pongleftx && pongbally+ pongball >=pongplayery
  && pongbally<=pongplayery+pongpaddle_height){//if ball is moving towards player
    //balls right edge on paddle,left edge not passed it, vertical ranges overlap
    pongballx = pongleftx+pongpaddle_width;//ball in front of paddle
    pongvx = -pongvx; //reverses direction
    pongvy = ((pongbally +pongball/2)-(pongplayery+pongpaddle_height/2))/7;
    pongvy += random(-1,2) //if it hits on top half goes up,else goes down,mid
