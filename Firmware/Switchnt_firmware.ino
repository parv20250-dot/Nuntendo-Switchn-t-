void menudrawfinal(){
  if(newscreen=true){
    newscreen = false;
    tft.fillScreen(purple);//clears everything
    draw_text_at(8,6,"GAMES",2,color_text); //heading games at top
    menudrawbattery(); //battery icon
    menudrawsound(); //mute/unmute icons
    for (int i =0;i< GAME_COUNT;I++){
      drawiconoutline(i,i==menuselected);}//repreats for all games, 4 icons
    draw_text_center(Screen_Width/2,229, "A-> CHOOSE | X->mute | SELECT->
      SETTINGS",Lessdark_purple);}} //shows button instructions at bottom
  int old =menuselected;
  int col = menuselected%2;
  int row = menuselected/2;//selcetd tile 0,0;1,0;0,1;1,1
  if(pressed(Button_left)&&col ==1){
    menuselected -=1;}//one starts at left so it does nun
  if(pressed(Button_right)&&col==0){
    menuselected +=1;} //1 to go to tile 1 (to right)
  if(pressed(Button_up)&&row ==1){
    menuselected -=2;}//starts up so ya do nun
  if(pressed(Button_down)&&row ==0){
    menuselected +=2;} //2 to go to til 2(down)
  if(menuselected != old){
    drawiconoutline(old,false) //draws icon of selcted again
    drawiconoutline(menuselected,true);}
    sfxtick(); //plays sound
  if (pressed(Button_A)){
    currentgame =(GAMESSSSS)menuselected; //if A pressed then game is selcted
    sfxtick();
    changescreen(screen_infor); //shows game info screen
    return;}
  if (batteryPercent!= menubatterywhown){menudrawbattery()}//updates battery
  if((soundmuted != menumuteshown)){menudrawsound();}} //updates sound
