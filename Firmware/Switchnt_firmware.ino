const uint8_t BRIGHTNESS_PWM[6]= {0,30,80,140,200,25};  //brightness levels

void backlightset (uint8_t level){
  if (level > 5) level =5;
  uint8_t duty = BRIGHTNESS_PWM[level];
  #if BACKLIGHT_ACTIVE 
  duty = 255- duty;
  #end if 
  analogWrite(TFT_BLKPIN,duty);}

void display_begin (){
  pinMode(TFT_BLKPIN, OUTPUT);
  analogWriteFeq(20000); //fast to ensure no flickering
  backlightset(0); //stays dark
  SPI.setSCK(TFT_SCLPIN);
  SPI.setTX(TFT_SDAPIN);
  SPI.setRX(-1); //no output from screen, just visual display
  tft.init(Screen_Width, Screen_Height, TFT_MODE)
  tft.setSPISpeed(40000000); //40MHz
  tft.SetRotation(0); //no rotation on images
  #if tft_invert
  tft.invertDisplay(true); 
  #endif 
  pinMode(TFT_DCPIN,OUTPUT);
  tft.fillScreen(purple);} //sets purple background

